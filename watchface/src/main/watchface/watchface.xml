<?xml version="1.0" encoding="utf-8"?>
<!--
  WristPet face (WFF v4, Galaxy Watch4 44mm, 450x450).
  Template: the build replaces the PET_SPRITES marker with the bundled pets' animations
  (assets/sprites + face-pets.txt, see buildSrc/SpriteTasks.kt) and writes res/raw/watchface.xml.

  Layout (x, y, w, h): date 125,55,200,30 · time 75,90,300,110 · pet 145,220,160,160 · battery 175,395,100,25
  Widget slots: left 50,240,80,80 · right 320,240,80,80 · edge rings at radius 215 (steps left, battery right)
  Palette: mint #7FE0B0 · cream #F2EBD9 · near-black #1A1C1E · lavender #B9A6F2 · coral #FF8A7A
  Theme colors: [CONFIGURATION.theme.0] = accent, [CONFIGURATION.theme.1] = secondary.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:32"/>

  <UserConfigurations>
    <ColorConfiguration id="theme" displayName="@string/config_theme" defaultValue="mint">
      <ColorOption id="mint" displayName="@string/theme_mint" colors="#FF7FE0B0 #FFB9A6F2"/>
      <ColorOption id="lavender" displayName="@string/theme_lavender" colors="#FFB9A6F2 #FF7FE0B0"/>
      <ColorOption id="coral" displayName="@string/theme_coral" colors="#FFFF8A7A #FFF2EBD9"/>
      <ColorOption id="mono" displayName="@string/theme_mono" colors="#FFF2EBD9 #FF9A9A9A"/>
    </ColorConfiguration>
    <BooleanConfiguration id="rings" displayName="@string/config_rings" defaultValue="TRUE"/>
  </UserConfigurations>

  <Scene backgroundColor="#FF000000">

    <!-- Edge rings: steps (left, grows upward) and battery (right, grows upward). Hidden in ambient. -->
    <BooleanConfiguration id="rings">
      <BooleanOption id="TRUE">
        <Group name="rings" x="0" y="0" width="450" height="450">
          <Variant mode="AMBIENT" target="alpha" value="0"/>
          <PartDraw x="0" y="0" width="450" height="450">
            <Arc centerX="225" centerY="225" width="430" height="430" startAngle="225" endAngle="315">
              <Stroke color="#FF2A2D30" thickness="6" cap="ROUND"/>
            </Arc>
            <Arc centerX="225" centerY="225" width="430" height="430" startAngle="225" endAngle="225">
              <Transform target="endAngle" value="225 + 90 * clamp([STEP_PERCENT], 0, 100) / 100"/>
              <Stroke color="[CONFIGURATION.theme.0]" thickness="6" cap="ROUND"/>
            </Arc>
            <Arc centerX="225" centerY="225" width="430" height="430" startAngle="45" endAngle="135">
              <Stroke color="#FF2A2D30" thickness="6" cap="ROUND"/>
            </Arc>
            <Arc centerX="225" centerY="225" width="430" height="430" startAngle="135" endAngle="135">
              <Transform target="startAngle" value="135 - 90 * clamp([BATTERY_PERCENT], 0, 100) / 100"/>
              <Stroke color="[CONFIGURATION.theme.1]" thickness="6" cap="ROUND"/>
            </Arc>
          </PartDraw>
        </Group>
      </BooleanOption>
    </BooleanConfiguration>

    <!-- Date: tap opens Calendar. -->
    <Group name="date" x="125" y="55" width="200" height="30">
      <Launch target="CALENDAR"/>
      <PartText x="0" y="0" width="200" height="30">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="24" color="[CONFIGURATION.theme.1]" weight="MEDIUM">
            <Template>%s %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

    <!-- Time: tap opens Alarms. -->
    <Group name="time" x="75" y="90" width="300" height="110">
      <Launch target="ALARM"/>
      <DigitalClock x="0" y="0" width="300" height="110">
        <TimeText x="0" y="0" width="300" height="110" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="96" color="#FFF2EBD9" weight="BOLD"/>
        </TimeText>
      </DigitalClock>
    </Group>

    <!--
      The pet. The app's RANGED_VALUE complication carries speciesIndex * 100 + stage * 10 + mood;
      the build replaces the marker below with every bundled pet's animations (buildSrc/SpriteTasks.kt).
      While charging (off the wrist) the pet plays its sad animation, except while it sleeps.
    -->
    <!-- slotId 4: the watch remembers bindings by slot ID, and slot 0 was once bound as SMALL_IMAGE. -->
    <ComplicationSlot slotId="4" name="pet" displayName="@string/pet_slot_name"
        x="145" y="220" width="160" height="160"
        supportedTypes="RANGED_VALUE SMALL_IMAGE" isCustomizable="TRUE">
      <DefaultProviderPolicy
          defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
          primaryProvider="dev.ashish.wristpet/dev.ashish.wristpet.complication.PetComplicationService"
          primaryProviderType="RANGED_VALUE"/>
      <BoundingBox x="0" y="0" width="160" height="160"/>
      <Complication type="RANGED_VALUE">
        <!-- @PET_SPRITES@ -->
      </Complication>
      <Complication type="SMALL_IMAGE">
        <PartImage x="0" y="0" width="160" height="160">
          <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
        </PartImage>
      </Complication>
    </ComplicationSlot>

    <!-- Widget slots beside the pet; pick any provider from Customize. Hidden in ambient. -->
    <Group name="widget_backdrops" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <PartDraw x="0" y="0" width="450" height="450">
        <Ellipse x="50" y="240" width="80" height="80"><Fill color="#FF1A1C1E"/></Ellipse>
        <Ellipse x="320" y="240" width="80" height="80"><Fill color="#FF1A1C1E"/></Ellipse>
      </PartDraw>
    </Group>
    <ComplicationSlot slotId="1" name="left" displayName="@string/left_slot_name"
        x="50" y="240" width="80" height="80"
        supportedTypes="SHORT_TEXT RANGED_VALUE MONOCHROMATIC_IMAGE SMALL_IMAGE" isCustomizable="TRUE">
      <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT"/>
      <BoundingOval x="0" y="0" width="80" height="80"/>
      <Complication type="SHORT_TEXT">
      <PartImage x="28" y="10" width="24" height="24" tintColor="[CONFIGURATION.theme.0]">
        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
      </PartImage>
      <PartText x="4" y="34" width="72" height="24">
        <Text align="CENTER" ellipsis="TRUE">
          <Font family="SYNC_TO_DEVICE" size="20" color="#FFF2EBD9" weight="BOLD">
            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="4" y="56" width="72" height="16">
        <Text align="CENTER" ellipsis="TRUE">
          <Font family="SYNC_TO_DEVICE" size="13" color="[CONFIGURATION.theme.1]">
            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
          </Font>
        </Text>
      </PartText>
      </Complication>
      <Complication type="RANGED_VALUE">
      <PartDraw x="0" y="0" width="80" height="80">
        <Arc centerX="40" centerY="40" width="70" height="70" startAngle="0" endAngle="360">
          <Stroke color="#FF2A2D30" thickness="5"/>
        </Arc>
        <Arc centerX="40" centerY="40" width="70" height="70" startAngle="0" endAngle="0">
          <Transform target="endAngle" value="360 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1)"/>
          <Stroke color="[CONFIGURATION.theme.0]" thickness="5" cap="ROUND"/>
        </Arc>
      </PartDraw>
      <PartImage x="30" y="14" width="20" height="20" tintColor="[CONFIGURATION.theme.0]">
        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
      </PartImage>
      <PartText x="4" y="34" width="72" height="24">
        <Text align="CENTER" ellipsis="TRUE">
          <Font family="SYNC_TO_DEVICE" size="18" color="#FFF2EBD9" weight="BOLD">
            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
          </Font>
        </Text>
      </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
      <PartImage x="20" y="20" width="40" height="40" tintColor="[CONFIGURATION.theme.0]">
        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
      </PartImage>
      </Complication>
      <Complication type="SMALL_IMAGE">
      <PartImage x="12" y="12" width="56" height="56">
        <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
      </PartImage>
      </Complication>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
    </ComplicationSlot>
    <ComplicationSlot slotId="2" name="right" displayName="@string/right_slot_name"
        x="320" y="240" width="80" height="80"
        supportedTypes="SHORT_TEXT RANGED_VALUE MONOCHROMATIC_IMAGE SMALL_IMAGE" isCustomizable="TRUE">
      <DefaultProviderPolicy defaultSystemProvider="HEART_RATE" defaultSystemProviderType="SHORT_TEXT"/>
      <BoundingOval x="0" y="0" width="80" height="80"/>
      <Complication type="SHORT_TEXT">
      <PartImage x="28" y="10" width="24" height="24" tintColor="[CONFIGURATION.theme.0]">
        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
      </PartImage>
      <PartText x="4" y="34" width="72" height="24">
        <Text align="CENTER" ellipsis="TRUE">
          <Font family="SYNC_TO_DEVICE" size="20" color="#FFF2EBD9" weight="BOLD">
            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
          </Font>
        </Text>
      </PartText>
      <PartText x="4" y="56" width="72" height="16">
        <Text align="CENTER" ellipsis="TRUE">
          <Font family="SYNC_TO_DEVICE" size="13" color="[CONFIGURATION.theme.1]">
            <Template>%s<Parameter expression="[COMPLICATION.TITLE]"/></Template>
          </Font>
        </Text>
      </PartText>
      </Complication>
      <Complication type="RANGED_VALUE">
      <PartDraw x="0" y="0" width="80" height="80">
        <Arc centerX="40" centerY="40" width="70" height="70" startAngle="0" endAngle="360">
          <Stroke color="#FF2A2D30" thickness="5"/>
        </Arc>
        <Arc centerX="40" centerY="40" width="70" height="70" startAngle="0" endAngle="0">
          <Transform target="endAngle" value="360 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]), 0, 1)"/>
          <Stroke color="[CONFIGURATION.theme.0]" thickness="5" cap="ROUND"/>
        </Arc>
      </PartDraw>
      <PartImage x="30" y="14" width="20" height="20" tintColor="[CONFIGURATION.theme.0]">
        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
      </PartImage>
      <PartText x="4" y="34" width="72" height="24">
        <Text align="CENTER" ellipsis="TRUE">
          <Font family="SYNC_TO_DEVICE" size="18" color="#FFF2EBD9" weight="BOLD">
            <Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template>
          </Font>
        </Text>
      </PartText>
      </Complication>
      <Complication type="MONOCHROMATIC_IMAGE">
      <PartImage x="20" y="20" width="40" height="40" tintColor="[CONFIGURATION.theme.0]">
        <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]"/>
      </PartImage>
      </Complication>
      <Complication type="SMALL_IMAGE">
      <PartImage x="12" y="12" width="56" height="56">
        <Image resource="[COMPLICATION.SMALL_IMAGE]"/>
      </PartImage>
      </Complication>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
    </ComplicationSlot>

    <!-- Battery: tap opens battery status. Hidden in ambient. -->
    <Group name="battery" x="175" y="395" width="100" height="25">
      <Launch target="BATTERY_STATUS"/>
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <PartText x="0" y="0" width="100" height="25">
        <Text align="CENTER">
          <Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.theme.0]">
            <Template>%d%%<Parameter expression="[BATTERY_PERCENT]"/></Template>
          </Font>
        </Text>
      </PartText>
    </Group>

  </Scene>
</WatchFace>
